{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "signal-timeline": {
      "projectType": "library",
      "root": "projects/signal-timeline",
      "sourceRoot": "projects/signal-timeline/src",
      "prefix": "st",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/signal-timeline/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/signal-timeline/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/signal-timeline/tsconfig.spec.json",
            "runner": "vitest",
            "coverageInclude": [
              "projects/signal-timeline/src/**/*.ts",
              "projects/signal-timeline/devtools/src/**/*.ts"
            ],
            "coverageExclude": [
              "projects/signal-timeline/src/**/*.spec.ts",
              "projects/signal-timeline/src/**/*.type-spec.ts",
              "projects/signal-timeline/src/**/testing/**",
              "projects/signal-timeline/src/public-api.ts",
              "projects/signal-timeline/devtools/src/**/*.spec.ts",
              "projects/signal-timeline/devtools/src/**/*.type-spec.ts",
              "projects/signal-timeline/devtools/src/**/testing/**",
              "projects/signal-timeline/devtools/src/public-api.ts"
            ],
            "coverageReporters": ["text-summary", "json-summary", "html"],
            "include": ["**/*.spec.ts", "../devtools/src/**/*.spec.ts"]
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "demo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              }
            ],
            "styles": ["projects/demo/src/styles.css"],
            "baseHref": "/",
            "outputPath": "dist/demo"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/signal-timeline/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/demo/tsconfig.spec.json",
            "runner": "vitest",
            "coverageInclude": ["projects/demo/src/**/*.ts"],
            "coverageExclude": ["projects/demo/src/**/*.spec.ts", "projects/demo/src/main.ts"],
            "coverageReporters": ["text-summary", "json-summary", "html"]
          }
        }
      }
    }
  }
}
