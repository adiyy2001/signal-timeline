{
  "name": "signal-timeline-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "lint": "eslint . && node tools/check-style.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "test": "ng test signal-timeline --no-watch && ng test demo --no-watch",
    "test:coverage": "ng test signal-timeline --no-watch --coverage && ng test demo --no-watch --coverage && node tools/check-coverage.mjs",
    "test:types": "tsc --noEmit -p projects/signal-timeline/tsconfig.type-tests.json",
    "build": "ng build signal-timeline && node tools/finalize-package.mjs",
    "bench": "node bench/run.mjs all",
    "bench:node": "node bench/run.mjs node",
    "bench:chromium": "node bench/run.mjs chromium",
    "bench:smoke": "node bench/run.mjs all --smoke",
    "bench:report": "node tools/report-bench.mjs --write",
    "pack:lib": "pnpm build && node tools/check-tarball.mjs",
    "pack:release": "node tools/compat.mjs 21 --release && node tools/check-tarball.mjs",
    "build:demo": "ng build demo --configuration production",
    "test:e2e": "node tools/run-e2e.mjs",
    "lighthouse": "node tools/lighthouse.mjs",
    "screenshots": "node tools/demo-screenshots.mjs",
    "docs:api": "typedoc",
    "build:site": "node tools/build-site.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@ngrx/signals": "22.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "axe-core": "4.13.0",
    "cypress": "16.1.1",
    "cypress-axe": "1.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "expect-type": "1.4.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "ng-packagr": "22.2.4",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "rfc6902": "5.3.0",
    "rxjs": "7.8.2",
    "sirv": "3.0.2",
    "tinybench": "6.2.0",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "zone.js": "0.16.3"
  }
}
